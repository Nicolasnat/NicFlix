generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["nicflix_schema", "public"]
}

model movies {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  category    String?
  thumbnail   String?
  video_url   String
  created_at  DateTime? @default(now()) @db.Timestamp(6)

  @@schema("nicflix_schema")
}

model users {
  id         Int       @id @default(autoincrement())
  name       String
  email      String    @unique
  password   String
  created_at DateTime? @default(now()) @db.Timestamp(6)

  @@schema("nicflix_schema")
}
